  "patterns": [
    { "regex": "^(\\d+)\\s+agents?\\s+running$", "replace": "$1 个智能体正在运行" },
    { "regex": "^No agents running$", "replace": "无运行中的智能体" },
    { "regex": "^Conversation\\s+(\\d+)$", "replace": "对话 $1" },
    { "regex": "^(\\d+)\\s+files?\\s+changed$", "replace": "$1 个文件已变更" },
    { "regex": "^(\\d+)\\s+files?\\s+modified$", "replace": "$1 个文件已修改" },
    { "regex": "^(\\d+)\\s+additions?,\\s*(\\d+)\\s+deletions?$", "replace": "$1 处新增，$2 处删除" },
    { "regex": "^(\\d+)\\s*s\\s+ago$", "replace": "$1 秒前" },
    { "regex": "^(\\d+)\\s*m\\s+ago$", "replace": "$1 分钟前" },
    { "regex": "^(\\d+)\\s*h\\s+ago$", "replace": "$1 小时前" },
    { "regex": "^(\\d+)\\s*d\\s+ago$", "replace": "$1 天前" },
    { "regex": "^(\\d+)\\s*w\\s+ago$", "replace": "$1 周前" },
    { "regex": "^(\\d+)\\s*mo\\s+ago$", "replace": "$1 个月前" },
    { "regex": "^(\\d+)\\s*y\\s+ago$", "replace": "$1 年前" },
    { "regex": "^Just now$", "replace": "刚刚" },
    { "regex": "^Updated\\s+(.+)$", "replace": "更新于 $1" },
    { "regex": "^Signed in as\\s+(.+)$", "replace": "已登录为 $1" },
    { "regex": "^Authenticated as\\s+(.+)$", "replace": "已验证身份为 $1" },
    { "regex": "^Settings\\s*-\\s*(.+)$", "replace": "设置 - $1" },
    { "regex": "^Show more\\s*\\((\\d+)\\)$", "replace": "显示更多 ($1)" },
    { "regex": "^See all\\s*\\((\\d+)\\)$", "replace": "查看全部 ($1)" },
    { "regex": "^Comments\\s*\\((\\d+)\\)$", "replace": "评论 ($1)" },
    { "regex": "^Generation Steps\\s*\\((\\d+)\\)$", "replace": "生成步骤 ($1)" },
    { "regex": "^Subagent:\\s*(.+)$", "replace": "子智能体：$1" },
    { "regex": "^Plugin:\\s*(.+)$", "replace": "插件：$1" },
    { "regex": "^Project:\\s*(.+)$", "replace": "项目：$1" },
    { "regex": "^Status:\\s*(.+)$", "replace": "状态：$1" },
    { "regex": "^Working [Dd]irectory:\\s*(.+)$", "replace": "工作目录：$1" },
    { "regex": "^Are you sure you want to delete\\s+(.+)\\?$", "replace": "确定要删除 $1 吗？" },
    { "regex": "^Open\\s+(.+)$", "replace": "打开 $1" }
  ]
}
